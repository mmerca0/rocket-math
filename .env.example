# Copy this file to .env.local and fill in real values:
#   Mac:     cp .env.example .env.local
#   Windows: copy .env.example .env.local
#
# .env.local is ignored by Git. For production, add the same keys in
# Vercel → Project → Settings → Environment Variables.
#
# Variables starting with NEXT_PUBLIC_ are sent to the browser — never put secrets in them.
# None of the variables below may ever start with NEXT_PUBLIC_.

# ---- Family leaderboard (Supabase) — server only ----
# Supabase → Project Settings → API (Data API) → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret keys (starts with sb_secret_).
# Full database access, bypasses Row Level Security. Server only. Never share.
SUPABASE_SECRET_KEY=
# Any phrase you choose. Typed once on each family device to join the leaderboard.
FAMILY_CODE=
